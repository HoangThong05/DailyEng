# Chép file này thành .env.local rồi điền giá trị thật.
# Cách nhanh nhất: Supabase dashboard → nút Connect → App Frameworks → Next.js,
# copy nguyên khối .env.local nó sinh ra và dán đè xuống dưới.

# Địa chỉ thật của trang (cho thẻ chia sẻ và sitemap). Bỏ trống thì dùng link Vercel.
NEXT_PUBLIC_SITE_URL=

# Dạng https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Điền MỘT trong hai dòng dưới, tuỳ dashboard của bạn sinh ra tên nào.
# Key này lộ ra client là bình thường — dữ liệu được bảo vệ bằng Row Level Security.
# Tuyệt đối KHÔNG dùng service_role / secret key, nó bỏ qua toàn bộ RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Nhắc học hằng ngày (Web Push) — tuỳ chọn, thiếu thì app vẫn chạy ---
# Sinh cặp khoá: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Chuỗi bí mật bất kỳ; pg_cron (schema-06) gửi kèm khi gọi /api/cron/nhac-hoc.
# Cùng giá trị này phải được nạp vào Vault của Supabase với tên dailyeng_cron_secret.
CRON_SECRET=

# Chỉ cron dùng, để đọc subscription của mọi người dùng.
# KHÔNG đặt tên NEXT_PUBLIC_* — key này bỏ qua toàn bộ RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- "Hỏi AI" (con vịt góc dưới phải). Cần MỘT trong hai khoá dưới; không có thì tính năng tự ẩn ---

# Miễn phí: https://aistudio.google.com/apikey (không cần thẻ). Lưu ý gói miễn phí
# cho phép Google dùng nội dung hội thoại để cải thiện sản phẩm của họ.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Trả phí, chất lượng cao hơn: https://console.anthropic.com → API Keys.
# Có khoá này thì app ưu tiên dùng Claude. Cũng dùng cho scripts/generate-decks.mts.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# Hạn mức tin nhắn mỗi người: mỗi ngày (mặc định 50) và mỗi phút (mặc định 6).
# AI_DAILY_LIMIT=50
# AI_MINUTE_LIMIT=6

# Ảnh cho trò Nghe chọn hình (scripts/fetch-photos.py). Đăng ký miễn phí: https://pixabay.com/api/docs/
PIXABAY_KEY=
