# Chép file này thành .env.local rồi điền giá trị thật.
# Lấy ở Supabase dashboard → Project Settings → API.

# Dạng https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Dùng "anon public" key (hoặc publishable key nếu project của bạn đã bật key mới).
# Key này lộ ra client là bình thường — dữ liệu được bảo vệ bằng Row Level Security.
# Tuyệt đối KHÔNG đặt service_role key ở đây, nó bỏ qua toàn bộ RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
